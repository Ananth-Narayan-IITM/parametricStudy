#!/bin/bash

# --------------------------------------------------
# Main controller for the OpenFOAM parametric engine
# --------------------------------------------------

# Resolve the real script location even when invoked through a symlink.
SOURCE=${BASH_SOURCE[0]}
while [ -L "$SOURCE" ]; do
    SOURCE_DIR=$(cd -P "$(dirname "$SOURCE")" && pwd) || exit 1
    SOURCE=$(readlink "$SOURCE")
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$SOURCE_DIR/$SOURCE" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SOURCE")" && pwd) || exit 1
export PARAMETRIC_CORE_DIR="$SCRIPT_DIR/core"

CASE_DIR=""
MODE=""
COMMAND="run"
RERUN_CASES=()
CASE_QUERY=""
EXPECT_CASE_NAME=0
CLEAN_YES=0
SAVE_ON_FAILURE=0

usage() {
    cat <<'EOF'
Usage:
  allParametric [caseDir] [options]
  allParametric [caseDir] --rerun <case1> <case2> ...

Options:
  -a, --append    Append new cases to existing results
  -d, --delete    Delete previous results before running
  -b, --backup    Back up previous results before running (default)
  -r, --rerun     Rerun selected cases from the base case
  -c, --case      Show details for one case (follows live log while running)
  -x, --clean     Remove generated parametric files (asks before main data folders)
  -y, --yes       Assume yes for cleanup confirmations
  -s, --save-on-failure
                  Write partial results to paramDatabase and clean work dirs on failure
  -e, --export    Add this parametricStudy directory to PATH
  -h, --help      Show this help

Examples:
  allParametric --delete
  allParametric /path/to/case --append
  allParametric --rerun h0R20v8 h0R20v9
  allParametric /path/to/case --rerun h0R20v8
  allParametric --case h0R20v8
  allParametric --clean               # asks before deleting main data folders
  allParametric --clean --yes         # no confirmation
  allParametric --save-on-failure     # write partial results if a case fails
  allParametric --export              # add to ~/.bashrc for future shells
  source ./allParametric --export     # add to this shell only
EOF
}

for arg in "$@"; do

    if [ "$EXPECT_CASE_NAME" -eq 1 ]; then
        CASE_QUERY="$arg"
        EXPECT_CASE_NAME=0
        continue
    fi

    case "$arg" in
        rerun|--rerun|-r)
            COMMAND="rerun"
            ;;
        --delete|-d)
            MODE="--delete"
            ;;
        --append|-a)
            MODE="--append"
            ;;
        --backup|-b)
            MODE="--backup"
            ;;
        --case|-c)
            COMMAND="case"
            EXPECT_CASE_NAME=1
            ;;
        --clean|-x)
            COMMAND="clean"
            ;;
        --yes|-y)
            CLEAN_YES=1
            ;;
        --save-on-failure|-s)
            SAVE_ON_FAILURE=1
            ;;
        --export|-e)
            COMMAND="export"
            ;;
        --help|-h|help)
            usage
            exit 0
            ;;
        -*)
            echo "[FAIL] Unknown option: $arg" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [ "$COMMAND" == "rerun" ]; then
                RERUN_CASES+=("$arg")
            else
                if [ -n "$CASE_DIR" ]; then
                    echo "[FAIL] Only one case directory may be given" >&2
                    exit 1
                fi
                CASE_DIR="$arg"
            fi
            ;;
    esac
done

# Add the engine directory to PATH.  A child process cannot change its
# parent shell, so when executed this updates ~/.bashrc; when sourced it
# updates the current shell immediately.
if [ "$COMMAND" == "export" ]; then
    exportLine="export PATH=\"$SCRIPT_DIR:\$PATH\""
    if [ "${BASH_SOURCE[0]}" != "$0" ]; then
        export PATH="$SCRIPT_DIR:$PATH"
        echo "[ OK ] Added to current shell PATH:"
        echo "       $SCRIPT_DIR"
        return 0 2>/dev/null || exit 0
    fi

    case "${SHELL:-/bin/bash}" in
        *zsh) rcFile="$HOME/.zshrc" ;;
        *)    rcFile="$HOME/.bashrc" ;;
    esac
    if [ -f "$rcFile" ] && grep -Fq "$exportLine" "$rcFile"; then
        echo "[INFO] PATH entry already present in $rcFile"
    else
        {
            echo ""
            echo "# OpenFOAM parametric study engine"
            echo "$exportLine"
        } >> "$rcFile"
        echo "[ OK ] Added PATH entry to $rcFile"
    fi

    echo "       $exportLine"
    echo "Run: source $rcFile"
    exit 0
fi

# No case directory: assume the command is run from inside the case.
[ -z "$CASE_DIR" ] && CASE_DIR="$PWD"
[ -z "$MODE" ] && MODE="--backup"
[ "$COMMAND" == "rerun" ] && MODE="rerun"
[ "$COMMAND" == "case" ] && MODE="case"
[ "$COMMAND" == "clean" ] && MODE="clean"

if [ "$COMMAND" == "rerun" ] && [ ${#RERUN_CASES[@]} -eq 0 ]; then
    echo "[FAIL] rerun requires at least one case name" >&2
    exit 1
fi

if [ "$COMMAND" == "case" ] && [ -z "$CASE_QUERY" ]; then
    echo "[FAIL] --case requires a case name" >&2
    exit 1
fi

if [ ! -d "$CASE_DIR" ]; then
    echo "[FAIL] Case directory not found: $CASE_DIR" >&2
    exit 1
fi

# Resolve to an absolute path before changing directory, so that
# background workers can always reach the base case.
CASE_DIR=$(cd "$CASE_DIR" && pwd) || exit 1

# --------------------------------------------------
# Load modules
# --------------------------------------------------

source "$PARAMETRIC_CORE_DIR/ui.sh"
source "$PARAMETRIC_CORE_DIR/config.sh"
source "$PARAMETRIC_CORE_DIR/utils.sh"
source "$PARAMETRIC_CORE_DIR/mesh.sh"
source "$PARAMETRIC_CORE_DIR/physics.sh"
source "$PARAMETRIC_CORE_DIR/solver.sh"
source "$PARAMETRIC_CORE_DIR/archive.sh"
source "$PARAMETRIC_CORE_DIR/database.sh"
source "$PARAMETRIC_CORE_DIR/cases.sh"
source "$PARAMETRIC_CORE_DIR/matrix.sh"
source "$PARAMETRIC_CORE_DIR/rerun.sh"
source "$PARAMETRIC_CORE_DIR/status.sh"
source "$PARAMETRIC_CORE_DIR/caseInfo.sh"
source "$PARAMETRIC_CORE_DIR/clean.sh"
source "$PARAMETRIC_CORE_DIR/runDetails.sh"
source "$PARAMETRIC_CORE_DIR/parallel.sh"
source "$PARAMETRIC_CORE_DIR/coreScreening.sh"

handle_failed_run() {

    local answer=n

    if ! has_failed_cases; then
        ui_error "Run failed before any case status was recorded."
        return 1
    fi

    print_failure_notes

    ui_kv "Work directory" "$PARAMETRIC_WORK_DIR"

    if [ "${SAVE_ON_FAILURE:-0}" -eq 1 ]; then
        answer=y
    elif [ -t 0 ]; then
        read -r -p "Write results to paramDatabase and clean temporary files? [y/N]: " answer
    fi

    case "$answer" in
        y|Y|yes|YES)
            if finalize_database; then
                rm -rf "$PARAMETRIC_WORK_DIR"
                rm -f "$SCRIPT_BACKUP"
                ui_ok "Partial results written to paramDatabase"
            else
                ui_error "Could not write partial results; work directory kept"
            fi
            ;;
        *)
            ui_info "Work directories kept for debugging: $PARAMETRIC_WORK_DIR"
            if [ "${SAVE_ON_FAILURE:-0}" -eq 0 ]; then
                ui_info "Use --save-on-failure to write partial results automatically."
            fi
            ;;
    esac
}

ui_banner "OpenFOAM Parametric Engine" "Parallel parametric case scheduler"
ui_kv "Case directory" "$CASE_DIR"
ui_kv "Mode" "$MODE"

# --------------------------------------------------
# Initialize
# --------------------------------------------------

if [ "$COMMAND" != "rerun" ] && [ "$COMMAND" != "case" ] && [ "$COMMAND" != "clean" ]; then
    handle_existing_data "$CASE_DIR" "$MODE"
fi

cd "$CASE_DIR" || exit

PARAMETRIC_STUDY_DIR="$CASE_DIR/parametricStudy"
PARAMETRIC_WORK_DIR="$CASE_DIR/parametricWork"
PARAMETRIC_LOG_DIR="$CASE_DIR/parametricLogs"
PARAMETRIC_STATUS_DIR="$CASE_DIR/parametricStatus"

if [ ! -f "$CASE_DIR/system/paramDict" ]; then
    echo "[FAIL] paramDict not found in $CASE_DIR" >&2
    echo "Run from a case directory, or pass the case directory first:" >&2
    if [ "$COMMAND" == "case" ]; then
        echo "  allParametric /path/to/case --case h0R20v8" >&2
    elif [ "$COMMAND" == "clean" ]; then
        echo "  allParametric /path/to/case --clean" >&2
    else
        echo "  allParametric /path/to/case --rerun h0R20v8" >&2
    fi
    exit 1
fi

load_config

if [ "$COMMAND" == "case" ]; then
    show_case_details "$CASE_QUERY" || exit 1
    rm -f "$SCRIPT_BACKUP"
    exit 0
fi

if [ "$COMMAND" == "clean" ]; then
    clean_generated_data || exit 1
    rm -f "$SCRIPT_BACKUP"
    exit 0
fi

validate_core_budget || exit 1

if ! is_true "$coreScreening"; then
    set_core_count "$processors"
else
    run_core_screening
fi

if [ "$COMMAND" == "rerun" ]; then

    if ! run_rerun "${RERUN_CASES[@]}"; then
        handle_failed_run
        exit 1
    fi

    ui_section "Database"
    finalize_database

    rm -f "$SCRIPT_BACKUP"
    ui_ok "Rerun complete"

    exit 0
fi

detect_append_index "$MODE"

# --------------------------------------------------
# Generate and run cases
# --------------------------------------------------

ui_section "Case matrix"
generate_cases

if ! run_all_cases; then
    handle_failed_run
    exit 1
fi

# --------------------------------------------------
# Database consolidation
# --------------------------------------------------

ui_section "Database"
finalize_database

# --------------------------------------------------
# Cleanup of temporary base-case backup only
# --------------------------------------------------

rm -f "$SCRIPT_BACKUP"

ui_ok "Parametric study preparation complete"
