FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// SOLVER * * * * * * * * * * * * * * * * * * * * * //
solver      ehdFoam_b4R11;
studyType   parametricStudy;
processors  1;
prefix      h0R20v;

// PARALLEL SCREENING * * * * * * * * * * * * * * * *//

coreScreening   false; // Boolean for coreScreening (true, false, 1, 0)
coreList        (1 2 4 6 8 12); // List of cores to be checked
coreEffMin      0.7; // Minimum required parallel efficiency

// PARALLEL EXECUTION * * * * * * * * * * * * * * * * * *//

availableCores      32; // Total cores available on this machine
maxConcurrentCases  auto; // 'auto' or maximum number of cases to run at once
continueFromPrevious false; // true = chain cases serially from previous result
logTimeZone         Asia/Kolkata; // time zone for human-readable logs (UTC, Europe/London, ...)

// MESH FILES * * * * * * * * * * * * * * * * * * * *//
meshFile    "Mesh/h0R19.geo";
meshOut     "Mesh/h0R19_OF.msh";

// COMMENTS * * * * * * * * * * * * * * * * * * * * *//
runComment  "Primal Solution";
runTag      "1e-7, Primal tolerance";
authorNote  "Su2021; Wu2015";

// PARAMETERS * * * * * * * * * * * * * * * * * * * *//
tag         true;
tagCases    (h0R20);
tagMerge    true;
distributed true;
nodesFile   system/nodes.conf;
workerRuntime container;
containerImage dafoam-stable:v6;
containerUser dafoamuser;
containerSource auto;
containerMount /home/dafoamuser/mount;
containerEnvScript /home/dafoamuser/dafoam/loadDAFoam.sh;
containerGroup daFoamReadWrite;
containerShmSize 4g;
containerAllmake true;
containerAllmakeLocal true;
containerAllmakeTimeout 900;
containerKeepOnFailure true;

parameters (T);
T (0 20 50 100 300 400);

// ************************************************************************* //
