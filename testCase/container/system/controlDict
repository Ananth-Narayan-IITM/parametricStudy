FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     ehdFoam_b4R11;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1e5;

deltaT          1.0;

writeControl    runTime;

writeInterval   1e5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   12;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

DebugSwitches
{
    dimensionSet 0;
    SolverPerformance 0;
}

