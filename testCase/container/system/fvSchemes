FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         Gauss deferredCorrection vanLeer;

    div(phi,U) bounded Gauss limitedLinearV 1;
    div(phi,T) bounded Gauss limitedLinear 1;
    div(phi,chargeDensity) bounded Gauss limitedLinear 1;
    div(potentialDifferenceFlux,chargeDensity) Gauss deferredCorrection vanLeer;
    div(pc) bounded Gauss upwind;
}
laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}

