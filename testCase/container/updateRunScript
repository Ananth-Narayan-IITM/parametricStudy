#!/bin/bash

# Run checkMesh and save the output
checkMesh > log.checkMesh 2>&1

# Extract the hexahedra count
nCells=$(grep "hexahedra:" log.checkMesh | awk '{print $2}')

# Check if extraction succeeded
if [ -z "$nCells" ]; then
    echo "ERROR: Could not determine hexahedra count."
    exit 1
fi

echo "Detected hexahedra count: $nCells"

# Replace the nCells line inside runScript.py
sed -i "s/^nCells *= *.*/nCells = $nCells # hexahedra count from checkMesh/" runScript.py

echo "Updated runScript.py"
