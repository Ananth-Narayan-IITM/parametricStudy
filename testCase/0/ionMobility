FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fluid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../calculationScript"

dimensions      [-1 0 2 0 0 1 0];

internalField   uniform $K;

boundaryField
{
    frontBack
    {
        type            empty;
    }
    "(topWall|bottomWall)"
    {
        type            zeroGradient;
        value           $internalField;
    }
    "(leftWall|rightWall)"
    {
        type            symmetryPlane;
        value           $internalField;
    }

}


