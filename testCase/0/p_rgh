FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fluid";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;
boundaryField
{
    frontBack
    {
        type            empty;
    }
    "(topWall|bottomWall)"
    {
        type zeroGradient;
        value $internalField;
    }
    
    "(leftWall|rightWall)"
    {
        type            symmetryPlane;
        value           $internalField;
    }
}


