// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          potentialDifference;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../calculationScript"

dimensions      [ 1 2 -3 0 0 -1 0 ];

internalField   uniform 0;

boundaryField
{
    "(leftWall|rightWall)"
    {
        type            symmetryPlane;
        value           $internalField;
    }
    bottomWall
    {
        type            fixedValue;
        value           uniform $dV;
    }
    topWall
    {
        type            fixedValue;
        value           uniform 0;
    }
    frontBack
    {
        type            empty;
    }
}


