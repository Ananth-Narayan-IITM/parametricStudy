FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fluid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../calculationScript"

dimensions      [ 0 -3 1 0 0 1 0 ];

internalField   uniform 0;

boundaryField
{
    frontBack
    {
        type            empty;
    }
    "(leftWall|rightWall)"
    {
        type            symmetryPlane;
    }
    
    "(topWall)"
    {
        type            zeroGradient;
    }
    
    "(bottomWall)"
    {
        type            fixedValue;
        value           uniform $q;
    }

}


