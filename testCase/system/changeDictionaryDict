FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


boundary
{
    frontBack
    {
        type            empty;
        physicalType    empty;
    }
    topWall
    {
        type            wall;
        physicalType    wall;
    }
    bottomWall
    {
        type            wall;
        physicalType    wall;
    }
    leftWall
    {
        type            symmetryPlane;
        physicalType    symmetryPlane;
    }
    rightWall
    {
        type            symmetryPlane;
        physicalType    symmetryPlane;
    }
