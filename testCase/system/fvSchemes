FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         					none;
    
    div(phi,U)      					Gauss limitedLinearV 1;
    div(phi,K)      					Gauss linear;
    div(phi,T)      					bounded Gauss vanLeer;
    div((nuEff*dev2(T(grad(U))))) 		Gauss linear;

    div(phi,chargeDensity)	    		Gauss deferredCorrection vanLeer;
    div(potentialDifferenceFlux,chargeDensity)          				Gauss deferredCorrection vanLeer;
    div(((-interpolate(ionMobility)*magSf)*snGrad(potentialDifference)),chargeDensity) 	Gauss deferredCorrection vanLeer;}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}

