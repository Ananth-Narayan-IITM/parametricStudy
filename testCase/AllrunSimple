#!/bin/bash
# --------------------------------------------------
# Plain case commands
#
# This is the file to inspect and run when checking a
# case before submitting it to the parametric study.
#
#   ./AllrunSimple
#
# All commands are visible and no timing or logging
# wrapper is used here.
# --------------------------------------------------

PARAM_DICT="${PARAM_DICT:-system/paramDict}"

if [ -z "$NP" ]; then
    NP=$(foamDictionary "$PARAM_DICT" -entry processors -value 2>/dev/null)
fi

if [ -z "$NP" ] || ! [[ "$NP" =~ ^[0-9]+$ ]] || [ "$NP" -lt 1 ]; then
    echo "[WARN] Invalid processors entry in $PARAM_DICT -> defaulting to serial"
    NP=1
fi

solver=$(foamDictionary "$PARAM_DICT" -entry solver -value)
cores=${NP:-1}

if [ "$cores" -gt 1 ]; then
    RUN_PARALLEL=1
else
    RUN_PARALLEL=0
fi

meshFile=$(foamDictionary "$PARAM_DICT" -entry meshFile -value | tr -d '"')
meshOut=$(foamDictionary "$PARAM_DICT" -entry meshOut -value | tr -d '"')

generate_mesh() {
    gmsh "${meshFile}" -3 -format msh2 -o "${meshOut}" &&
    gmshToFoam "${meshOut}" &&
    changeDictionary -constant
}

decompose_case() {
    rm -rf processor* &&
    foamDictionary system/decomposeParDict \
        -entry numberOfSubdomains \
        -set "$NP" &&
    decomposePar -force
}

solve_parallel() {
    mpirun -np "$NP" "$solver" -parallel
}

solve_serial() {
    "$solver"
}

reconstruct_case() {
    reconstructPar
}

run_simple_case() {

    if [ ! -d "constant/polyMesh" ]; then
        generate_mesh || return 1
    fi

    if [ "$RUN_PARALLEL" == "1" ]; then

        decompose_case || return 1
        solve_parallel || return 1

        if ls -d processor*/[0-9]* 2>/dev/null | grep -qv '/0$'; then
            reconstruct_case || return 1
        fi

    else
        solve_serial || return 1
    fi

    return 0
}

# Allow this file to be run directly for a quick case check.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    run_simple_case
fi
