#!/bin/bash
# --------------------------------------------------
# UNIVERSAL OpenFOAM Allrun
# Compatible with:
#   - Core screening
#   - Grid independence
#   - Parametric study
#   - Standalone execution
# --------------------------------------------------

PARAM_DICT="system/paramDict"

if [ -z "$NP" ]; then
    echo "[WARN] NP not defined -> defaulting to serial"
    NP=1
    RUN_PARALLEL=0
fi

# --------------------------------------------------
# Load solver
# --------------------------------------------------
solver=$(foamDictionary "$PARAM_DICT" -entry solver -value)

# --------------------------------------------------
# Detect cores
# Priority:
# 1) external workflow (coreScreening/parametric)
# 2) paramDict fallback
# --------------------------------------------------
cores=${NP:-1}

if [ "$cores" -gt 1 ]; then
    RUN_PARALLEL=1
else
    RUN_PARALLEL=0
fi

# --------------------------------------------------
# Mesh inputs
# --------------------------------------------------
meshFile=$(foamDictionary "$PARAM_DICT" -entry meshFile -value | tr -d '"')
meshOut=$(foamDictionary "$PARAM_DICT" -entry meshOut -value | tr -d '"')

echo "--------------------------------------------------"
echo "[INFO] Solver      : $solver"
echo "[INFO] Cores       : $cores"
echo "[INFO] Mesh source : $meshFile"
echo "--------------------------------------------------"

# --------------------------------------------------
# Mesh generation (only if needed)
# --------------------------------------------------
if [ ! -d "constant/polyMesh" ]; then

    echo "[INFO] Mesh not found -> generating"

    gmsh "${meshFile}" -3 -format msh2 -o "${meshOut}" || exit 1
    gmshToFoam "${meshOut}" || exit 1
    changeDictionary -constant || exit 1

else
    echo "[INFO] Existing mesh detected -> skipping generation"
fi

# --------------------------------------------------
# Clean previous decomposition safely
# --------------------------------------------------
if [ "$RUN_PARALLEL" == "1" ]; then

    echo "[Allrun] Parallel run with $NP cores"
    rm -rf processor*

    foamDictionary system/decomposeParDict \
        -entry numberOfSubdomains \
        -set "$NP" || exit 1
    decomposePar -force || exit 1
    mpirun -np "$NP" "$solver" -parallel || exit 1

    # reconstructPar returns non-zero when the solver has not written
    # any time directory yet (for example a very short run).
    if ls -d processor*/[0-9]* 2>/dev/null | grep -qv '/0$'; then
        reconstructPar || exit 1
    else
        echo "[Allrun] No processor time directories to reconstruct"
    fi

else

    echo "[Allrun] Serial run"
    "$solver" || exit 1
fi

echo "--------------------------------------------------"
echo "[INFO] RUN COMPLETE"
echo "--------------------------------------------------"
